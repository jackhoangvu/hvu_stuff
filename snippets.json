  "isqrt":{
    "prefix": "isqrt",
    "body": [
      "long long isqrt(long long n){",
      "  if(n<0) return 0;",
      "  long long x=sqrtl(n);",
      "  while((x+1)*(x+1)<=n) x++;",
      "  while(x*x>n) x--;",
      "  return x;",
      "}"
    ]
