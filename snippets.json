  "bp": {
    "prefix": "bp",
    "body": [
      "long long bp(long long b,long long e,long long m=mod){",
      "  b%=m;",
      "  long long ans=1;",
      "  while(e>0){",
      "    if(e&1) ans=ans*b%m;",
      "    b=b*b%m;",
      "    e>>=1;",
      "  }",
      "  return ans;",
      "}"
    ]
  },
